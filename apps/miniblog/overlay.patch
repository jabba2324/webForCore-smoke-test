diff --git a/Website/MiniBlog.csproj b/Website/MiniBlog.csproj
new file mode 100644
index 0000000..3a9ab02
--- /dev/null
+++ b/Website/MiniBlog.csproj
@@ -0,0 +1,47 @@
+<Project Sdk="Microsoft.NET.Sdk.Web">
+  <!-- Migrated to webForCore (.NET 11). MiniBlog was a Visual Studio web site (no project file); this project hosts it.
+       Pages (.cshtml) and app_code are compiled at run time, as on IIS. -->
+  <PropertyGroup>
+    <TargetFramework>net11.0</TargetFramework>
+    <OutputType>Exe</OutputType>
+    <AssemblyName>MiniBlog</AssemblyName>
+    <ImplicitUsings>disable</ImplicitUsings>
+    <Nullable>disable</Nullable>
+    <OutputPath>bin_dotnet</OutputPath>
+    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
+    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
+    <GenerateDependencyFile>true</GenerateDependencyFile>
+    <NoWarn>$(NoWarn);NU1701</NoWarn>
+    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
+    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
+    <RazorCompileOnBuild>false</RazorCompileOnBuild>
+    <RazorCompileOnPublish>false</RazorCompileOnPublish>
+  </PropertyGroup>
+
+  <ItemGroup>
+    <Compile Remove="App_Code/**;bin_dotnet/**;obj/**" />
+    <Content Remove="bin_dotnet/**" />
+    <None Remove="bin_dotnet/**" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <!-- webForCore 0.1.0 packages: the "Always" set, Web Pages and Helpers. -->
+    <PackageReference Include="webForCore" Version="0.2.0" />
+    <PackageReference Include="webForCore.Web.WebPages.Razor" Version="0.2.0" />
+    <PackageReference Include="webForCore.Web.WebPages.Deployment" Version="0.2.0" />
+    <PackageReference Include="webForCore.Web.Helpers" Version="0.2.0" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <!-- The site's own libraries, from its packages.config (they were checked into bin/). -->
+    <PackageReference Include="AjaxMin" Version="5.14.5506.26202" />
+    <PackageReference Include="WebMarkupMin.Core" Version="2.0.0" />
+    <PackageReference Include="xmlrpcnet" Version="3.0.0.266" />
+    <PackageReference Include="xmlrpcnet-server" Version="3.0.0.266" />
+    <!-- app_code/handlers/FeedHandler.cs uses System.ServiceModel.Syndication, part of .NET Framework (the root web.config
+         references System.ServiceModel); on .NET it is a package. -->
+    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.0" />
+    <!-- ImageCruncher.dll has no package; it stays in bin/ with the site, as it was. -->
+    <Reference Include="ImageCruncher" HintPath="bin/ImageCruncher.dll" />
+  </ItemGroup>
+</Project>
diff --git a/Website/Program.cs b/Website/Program.cs
new file mode 100644
index 0000000..751e61c
--- /dev/null
+++ b/Website/Program.cs
@@ -0,0 +1,18 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.Extensions.DependencyInjection;
+using WebFormsForCore.Hosting.IIS;
+
+// webForCore host (docs/MIGRATING.md section 4). MiniBlog uses no session state; extensionless URLs and the
+// web.config rewrite rules need every request to reach System.Web.
+public class Program
+{
+    public static void Main(string[] args)
+    {
+        var builder = WebApplication.CreateBuilder(args);
+        builder.Services.AddWebForms();
+
+        var app = builder.Build();
+        app.UseWebForms(o => o.HandleAllRequestsWithWebForms());
+        app.Run();
+    }
+}
