+       the default site template uses [G]Skins/Xcillion. -->
+  <Target Name="PackageXcillionSkin" AfterTargets="Build">
+    <PropertyGroup>
+      <XcillionDir>$(MSBuildProjectDirectory)/../Skins/Xcillion</XcillionDir>
+      <XcillionStage>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)XcillionPackage</XcillionStage>
+    </PropertyGroup>
+    <ItemGroup>
+      <XcillionSkinFiles Include="$(XcillionDir)/Skin/**/*.*" />
+      <XcillionContainerFiles Include="$(XcillionDir)/Container/**/*.*" />
+      <XcillionPackageFiles Include="$(XcillionDir)/DNN_Skin_Xcillion.dnn;$(XcillionDir)/license.htm;$(XcillionDir)/release_notes.htm" />
+    </ItemGroup>
+    <RemoveDir Directories="$(XcillionStage)" />
+    <Copy SourceFiles="@(XcillionSkinFiles)" DestinationFiles="@(XcillionSkinFiles->'$(XcillionStage)/skin/%(RecursiveDir)%(Filename)%(Extension)')" />
+    <Copy SourceFiles="@(XcillionContainerFiles)" DestinationFiles="@(XcillionContainerFiles->'$(XcillionStage)/container/%(RecursiveDir)%(Filename)%(Extension)')" />
+    <Copy SourceFiles="@(XcillionPackageFiles)" DestinationFolder="$(XcillionStage)/package" />
+    <ZipDirectory SourceDirectory="$(XcillionStage)/skin" DestinationFile="$(XcillionStage)/package/Resource-Skin.zip" Overwrite="true" />
+    <ZipDirectory SourceDirectory="$(XcillionStage)/container" DestinationFile="$(XcillionStage)/package/Resource-Container.zip" Overwrite="true" />
+    <MakeDir Directories="$(MSBuildProjectDirectory)/Install/Skin" />
+    <ZipDirectory SourceDirectory="$(XcillionStage)/package" DestinationFile="$(MSBuildProjectDirectory)/Install/Skin/Skin_Xcillion_09.13.10_Install.zip" Overwrite="true" />
+  </Target>
+
+</Project>
