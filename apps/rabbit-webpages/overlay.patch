diff --git a/WebSite/WebSite.csproj b/WebSite/WebSite.csproj
new file mode 100644
index 0000000..1c5cafa
--- /dev/null
+++ b/WebSite/WebSite.csproj
@@ -0,0 +1,41 @@
+<Project Sdk="Microsoft.NET.Sdk.Web">
+  <!-- Migrated to webForCore (.NET 10). The site was a WebMatrix (Visual Studio) web site with no project file; this
+       project hosts it. Pages (.cshtml) and App_Code are compiled at run time, as on IIS. -->
+  <PropertyGroup>
+    <TargetFramework>net10.0</TargetFramework>
+    <OutputType>Exe</OutputType>
+    <AssemblyName>RabbitSite</AssemblyName>
+    <ImplicitUsings>disable</ImplicitUsings>
+    <Nullable>disable</Nullable>
+    <OutputPath>bin_dotnet</OutputPath>
+    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
+    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
+    <GenerateDependencyFile>true</GenerateDependencyFile>
+    <NoWarn>$(NoWarn);NU1701</NoWarn>
+    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
+    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
+    <RazorCompileOnBuild>false</RazorCompileOnBuild>
+    <RazorCompileOnPublish>false</RazorCompileOnPublish>
+  </PropertyGroup>
+
+  <ItemGroup>
+    <Compile Remove="App_Code/**;bin_dotnet/**;obj/**" />
+    <Content Remove="bin_dotnet/**" />
+    <None Remove="bin_dotnet/**" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <!-- webForCore packages: the "Always" set, Web Pages and Helpers (WebSecurity, WebMail, Json). -->
+    <PackageReference Include="webForCore" Version="0.10.0" />
+    <PackageReference Include="webForCore.Web.WebPages.Razor" Version="0.10.0" />
+    <PackageReference Include="webForCore.Web.WebPages.Deployment" Version="0.10.0" />
+    <PackageReference Include="webForCore.Web.Helpers" Version="0.10.0" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <!-- WebMatrix.Data and WebMatrix.WebData (Database.Open, WebSecurity, SimpleMembership): the ASP.NET Web Pages 1
+         installer put them in the GAC. webForCore doesn't provide them, so the site uses Microsoft's packages. -->
+    <PackageReference Include="Microsoft.AspNet.WebPages.Data" Version="3.2.9" />
+    <PackageReference Include="Microsoft.AspNet.WebPages.WebData" Version="3.2.9" />
+  </ItemGroup>
+</Project>
