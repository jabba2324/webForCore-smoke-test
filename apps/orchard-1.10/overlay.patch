diff --git a/src/Orchard.Web/Program.cs b/src/Orchard.Web/Program.cs
new file mode 100644
index 000000000..01594407b
--- /dev/null
+++ b/src/Orchard.Web/Program.cs
@@ -0,0 +1,23 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.Extensions.DependencyInjection;
+using WebFormsForCore.Hosting.IIS;
+
+namespace Orchard.Web
+{
+    // webForCore host (docs/MIGRATING.md section 4). The app uses session state (MVC's TempData).
+    public class Program
+    {
+        public static void Main(string[] args)
+        {
+            var builder = WebApplication.CreateBuilder(args);
+            builder.Services.AddWebForms();
+            builder.Services.AddDistributedMemoryCache();
+
+            var app = builder.Build();
+            app.UseWebForms(o => o
+                .HandleAllRequestsWithWebForms()
+                .UseAspNetCoreSessionProvider());
+            app.Run();
+        }
+    }
+}
