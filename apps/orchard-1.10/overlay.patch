diff --git a/src/Orchard/Environment/AutofacUtil/XmlFileConfigurationReader.cs b/src/Orchard/Environment/AutofacUtil/XmlFileConfigurationReader.cs
new file mode 100644
index 000000000..5afdb6fef
--- /dev/null
+++ b/src/Orchard/Environment/AutofacUtil/XmlFileConfigurationReader.cs
@@ -0,0 +1,26 @@
+using System.Xml;
+using Autofac.Configuration;
+using Autofac.Configuration.Core;
+
+namespace Orchard.Environment.AutofacUtil {
+    /// <summary>
+    /// webForCore: reads an Autofac configuration section from a file, as ConfigurationSettingsReader(sectionName, file)
+    /// did. Autofac.Configuration 3.3.0 (built for .NET Framework 4.0) opens the file through
+    /// AppDomainSetup.ConfigurationFile, which .NET doesn't have (MissingMethodException); its
+    /// SectionHandler.Deserialize(XmlReader) reads the same XML without it.
+    /// </summary>
+    /// Internal: Orchard registers every public Autofac module in its assemblies with each shell.
+    internal class XmlFileConfigurationReader : ConfigurationModule {
+        public XmlFileConfigurationReader(string sectionName, string configurationFile) {
+            using (var reader = XmlReader.Create(configurationFile)) {
+                while (reader.Read()) {
+                    if (reader.NodeType == XmlNodeType.Element && reader.Name == sectionName && reader.Depth == 1) {
+                        SectionHandler = SectionHandler.Deserialize(reader);
+                        return;
+                    }
+                }
+            }
+            throw new XmlException(string.Format("The configuration file '{0}' has no '{1}' section.", configurationFile, sectionName));
+        }
+    }
+}
