--- /dev/null
+++ b/src/MVC3/MvcMusicStore-Completed/MvcMusicStore/Program.cs
@@ -0,0 +1,25 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.Extensions.DependencyInjection;
+using WebFormsForCore.Hosting.IIS;
+
+namespace MvcMusicStore
+{
+    // webForCore host (docs/MIGRATING.md section 4). The app uses session state.
+    public class Program
+    {
+        public static void Main(string[] args)
+        {
+            var builder = WebApplication.CreateBuilder(args);
+            builder.Services.AddWebForms();
+            builder.Services.AddDistributedMemoryCache();
+            builder.Services.AddSession();
+
+            var app = builder.Build();
+            app.UseSession();
+            app.UseWebForms(o => o
+                .HandleAllRequestsWithWebForms()
+                .UseAspNetCoreSessionProvider());
+            app.Run();
+        }
+    }
+}
