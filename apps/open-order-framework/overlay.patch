diff --git a/OpenOrderFramework/Program.cs b/OpenOrderFramework/Program.cs
new file mode 100644
index 0000000..eda4a11
--- /dev/null
+++ b/OpenOrderFramework/Program.cs
@@ -0,0 +1,25 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.Extensions.DependencyInjection;
+using WebFormsForCore.Hosting.IIS;
+
+namespace OpenOrderFramework
+{
+    // webForCore host (docs/MIGRATING.md section 4). The app uses session state.
+    public class Program
+    {
+        public static void Main(string[] args)
+        {
+            var builder = WebApplication.CreateBuilder(args);
+            builder.Services.AddWebForms();
+            builder.Services.AddDistributedMemoryCache();
+            builder.Services.AddSession();
+
+            var app = builder.Build();
+            app.UseSession();
+            app.UseWebForms(o => o
+                .HandleAllRequestsWithWebForms()
+                .UseAspNetCoreSessionProvider());
+            app.Run();
+        }
+    }
+}
